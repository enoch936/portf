# Copy this file to .env and fill in the values from your Neon project
# (Vercel Marketplace -> Neon). Both variables are injected automatically
# when the Neon integration is connected to your Vercel project.

# Pooled connection string (hostname contains "-pooler").
# Used by the app at runtime (Prisma client in lib/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection string.
# Used by the Prisma CLI: prisma generate / db push / db seed.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Strong random secret for signing admin session JWTs.
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Public URL of the deployed site (used for sitemap/robots).
NEXT_PUBLIC_SITE_URL="https://gebretsadik.io"
